# ==========================================
# MEMORA Server Environment Variables
# ==========================================

# Port and Environment
PORT=5000
NODE_ENV=development

# ------------------------------------------
# MongoDB Database Configuration
# ------------------------------------------
# Default: Local MongoDB instance
MONGO_URI=mongodb://127.0.0.1:27017/memora_db

# Alternative: MongoDB Atlas Cloud Cluster
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Example: MONGO_URI=mongodb+srv://memora_admin:SecurePassword123@cluster0.abcde.mongodb.net/memora_db?retryWrites=true&w=majority

# ------------------------------------------
# JWT Authentication (Phase 2)
# ------------------------------------------
JWT_SECRET=replace_this_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------
# Cloudinary Image Storage (Phase 4)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------
# Allowed Frontend Client Origin (CORS)
# ------------------------------------------
CLIENT_URL=http://localhost:5173
